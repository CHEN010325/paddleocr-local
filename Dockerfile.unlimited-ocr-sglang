# CUDA 12.9 is the first toolkit line that can compile FlashInfer kernels for
# Blackwell consumer GPUs (SM120). Keep the digest pinned so an upstream tag
# move cannot silently reintroduce an older, incompatible toolkit.
ARG CUDA_BASE_IMAGE=nvidia/cuda:12.9.1-cudnn-devel-ubuntu24.04@sha256:a2e1e2360c85298ac47ec2543b406ab1e8cec42e31ee47e4d32140ebc82e1067
FROM ${CUDA_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      build-essential \
      curl \
      git \
      libglib2.0-0 \
      libgl1 \
      libnuma1 \
      pkg-config \
      python-is-python3 \
      python3 \
      python3-dev \
      python3-pip \
      python3-venv && \
    rm -rf /var/lib/apt/lists/*

ARG UNLIMITED_OCR_SGLANG_WHEEL_URL=https://huggingface.co/baidu/Unlimited-OCR/resolve/07dea832e22aefee32ad281d4b80551282e1c168/wheel/sglang-0.0.0.dev11416%2Bg92e8bb79e-py3-none-any.whl?download=true#sha256=2644a1f349c55f0ca822e70a70679c98475754ec4722c3be1b18a72bac477cd5

RUN python -m venv /opt/venv && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
      "${UNLIMITED_OCR_SGLANG_WHEEL_URL}" \
      kernels==0.11.7 \
      pymupdf==1.27.2.2 \
      fastapi==0.136.1 \
      uvicorn==0.46.0 \
      httpx==0.28.1 \
      pydantic==2.11.10 \
      python-multipart==0.0.32 \
      Pillow==12.3.0

WORKDIR /app
COPY unlimited_ocr_adapter.py /app/unlimited_ocr_adapter.py
