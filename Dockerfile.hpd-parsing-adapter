WORKDIR /app

RUN pip install --no-cache-dir \
      fastapi==0.136.1 \
      uvicorn==0.46.0 \
      httpx==0.28.1 \
      Pillow==12.3.0 \
      pymupdf==1.27.2.2

COPY hpd_parsing_adapter.py /app/hpd_parsing_adapter.py

