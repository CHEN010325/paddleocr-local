# The official OCR-2 SGLang wheel uses CUDA 13 kernels. Pin the toolkit
# and artifact together, including Blackwell consumer GPU support.
ARG CUDA_BASE_IMAGE=nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04@sha256:e071e85c52ad91fc9ea24158ff5330876b2d1a5c4ac83ccc6066976835873c01
FROM ${CUDA_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      build-essential \
      curl \
      git \
      libglib2.0-0 \
      libgl1 \
      libnuma1 \
      pkg-config \
      python-is-python3 \
      python3 \
      python3-dev \
      python3-pip \
      python3-venv && \
    rm -rf /var/lib/apt/lists/*

ARG UNLIMITED_OCR_SGLANG_WHEEL_URL=https://huggingface.co/baidu/Unlimited-OCR-2/resolve/9cf077c4b206e0e2a31879df937b0b0bcba3661c/wheel/sglang-0.5.20.dev10%2Bg8d62f5fb9c-py3-none-any.whl?download=true#sha256=a3f3e2c94e09de90b61b43d01475fd5d1aa818d16eec05204b8079c09c2ba70d

RUN python -m venv /opt/venv && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
      "${UNLIMITED_OCR_SGLANG_WHEEL_URL}" \
      kernels==0.14.1 \
      fastokens==0.3.2 \
      pymupdf==1.27.2.2 \
      fastapi==0.136.1 \
      uvicorn==0.46.0 \
      httpx==0.28.1 \
      pydantic==2.11.10 \
      python-multipart==0.0.32 \
      Pillow==12.3.0

WORKDIR /app
COPY unlimited_ocr_adapter.py /app/unlimited_ocr_adapter.py
