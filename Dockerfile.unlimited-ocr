ARG CUDA_BASE_IMAGE=nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04@sha256:e071e85c52ad91fc9ea24158ff5330876b2d1a5c4ac83ccc6066976835873c01
FROM ${CUDA_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      build-essential \
      curl \
      git \
      libglib2.0-0 \
      libgl1 \
      libnuma1 \
      pkg-config \
      python-is-python3 \
      python3 \
      python3-dev \
      python3-pip \
      python3-venv && \
    rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cu130 \
      torch==2.13.0+cu130 \
      torchvision==0.28.0+cu130 && \
    pip install --no-cache-dir \
      transformers==4.52.1 \
      huggingface-hub==0.36.0 \
      tokenizers==0.21.4 \
      matplotlib==3.10.8 \
      einops==0.8.2 \
      addict==2.4.0 \
      easydict==1.13 \
      psutil==7.2.2 \
      pymupdf==1.27.2.2 \
      fastapi==0.136.1 \
      uvicorn==0.46.0 \
      httpx==0.28.1 \
      pydantic==2.11.10 \
      python-multipart==0.0.32 \
      Pillow==13.0.0

WORKDIR /app
COPY unlimited_ocr_adapter.py /app/unlimited_ocr_adapter.py
