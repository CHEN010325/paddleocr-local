FROM nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04@sha256:d02c4310b6d57ca0b16cd80298bdb33a74187baafe2eccd8a6a16180ddc90802

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      build-essential \
      curl \
      git \
      libglib2.0-0 \
      libgl1 \
      libgomp1 \
      python3 \
      python3-dev \
      python3-pip \
      python3-venv && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv && \
    pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/cu128 \
      torch==2.8.0 torchvision==0.23.0 && \
    pip install --no-cache-dir \
      transformers==4.57.1 \
      accelerate==1.12.0 \
      safetensors==0.7.0 \
      numpy==2.2.6 \
      opencv-python-headless==4.12.0.88 \
      'pypdfium2>=4.30,<5' \
      'pypdf>=6,<7' \
      'requests>=2.32,<3' \
      'aiohttp>=3.13,<4' \
      'httpx-retries>=0.4,<1' \
      'beautifulsoup4>=4.14,<5' \
      'fast-langdetect>=0.2,<0.3' \
      'magika>=1.0,<2' \
      'pyclipper>=1.4,<2' \
      'shapely>=2.1,<3' \
      'json-repair>=0.55,<1' \
      'boto3>=1.42,<2' \
      'qwen-vl-utils>=0.0.14,<0.1' \
      pydantic==2.11.10 \
      fastapi==0.136.1 \
      uvicorn==0.46.0 \
      python-multipart==0.0.32 \
      Pillow==12.3.0 \
      PyMuPDF==1.27.2.2 \
      loguru==0.7.3 \
      tqdm==4.67.1 \
      aiofiles==24.1.0 \
      httpx==0.28.1 && \
    pip install --no-cache-dir \
      vllm==0.11.0 \
      xformers==0.0.32.post1 && \
    pip install --no-cache-dir --no-deps \
      https://github.com/caipeng328/NaviDC-OCR/archive/737e185c7b74288091cd4395ea80c14b1f71422b.tar.gz

WORKDIR /app
COPY navidc_ocr_adapter.py /app/navidc_ocr_adapter.py

ENTRYPOINT []
CMD ["uvicorn", "navidc_ocr_adapter:app", "--host", "0.0.0.0", "--port", "8080"]
