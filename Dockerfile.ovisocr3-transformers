# Volta/Turing-compatible profile; the vLLM CUDA 12.9 image remains the default
# for newer supported hardware. PyTorch's CUDA 12.6 build includes sm_70.
FROM pytorch/pytorch:2.7.0-cuda12.6-cudnn9-runtime@sha256:27c3135420bc184e86977170b6158c6133be3c7cc5c35e9e4fa87bdda629dc2b

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ovis-browsers \
    OVISOCR3_BACKEND=transformers \
    OVISOCR3_TRANSFORMERS_DTYPE=float16 \
    OVISOCR3_ATTENTION_IMPLEMENTATION=sdpa

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libglib2.0-0 libgl1 fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir \
    transformers==5.14.1 fastapi==0.136.1 uvicorn==0.46.0 \
    python-multipart==0.0.32 Pillow==13.0.0 pymupdf==1.27.2.2 einops==0.8.2
WORKDIR /app
COPY requirements-ovisocr3-render.txt ./
RUN python -m pip install --no-cache-dir -r requirements-ovisocr3-render.txt && \
    python -m playwright install --with-deps chromium
ENV OVISOCR3_MAX_PIXELS=1048576 OVISOCR3_RELEASE_CUDA_CACHE=1
COPY ovisocr2_adapter.py ovisocr3_document.py ovisocr3_config.py ovisocr3_pdf.py ovisocr3_tasks.py ovisocr3_inference.py ovisocr3_crosspage.py ovisocr3_reference.py ./
COPY ovisocr3_prompts ./ovisocr3_prompts/
COPY ovisocr3_assets ./ovisocr3_assets/
ENTRYPOINT []
CMD ["uvicorn", "ovisocr2_adapter:app", "--host", "0.0.0.0", "--port", "8080"]
