FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir paddlepaddle==3.3.0 \
    --index-url https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && python -m pip install --no-cache-dir "paddlex[ocr,serving]==3.7.1"
COPY pipeline_config_ocr_cpu.yaml /app/pipeline.yaml
ENV PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
EXPOSE 8080
CMD ["paddlex", "--serve", "--pipeline", "/app/pipeline.yaml", "--device", "cpu", "--host", "0.0.0.0", "--port", "8080"]
