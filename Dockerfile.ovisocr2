FROM nvidia/cuda:12.9.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      build-essential \
      curl \
      libglib2.0-0 \
      libgl1 \
      python3 \
      python3-dev \
      python3-pip \
      python3-venv && \
    rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    /root/.local/bin/uv venv /opt/venv && \
    /root/.local/bin/uv pip install --python /opt/venv/bin/python \
      "vllm==0.22.1" \
      --extra-index-url https://wheels.vllm.ai/0.22.1/cu129 \
      --extra-index-url https://download.pytorch.org/whl/cu129 \
      --index-strategy unsafe-best-match && \
    /root/.local/bin/uv pip install --python /opt/venv/bin/python \
      fastapi==0.136.1 \
      uvicorn==0.46.0 \
      python-multipart==0.0.27 \
      Pillow==12.1.1 \
      pymupdf==1.27.2.2

WORKDIR /app
COPY ovisocr2_adapter.py /app/ovisocr2_adapter.py

ENTRYPOINT []
CMD ["uvicorn", "ovisocr2_adapter:app", "--host", "0.0.0.0", "--port", "8080"]
