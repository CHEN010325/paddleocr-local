{
  "name": "paddleocr-vl-webui-tests",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "npm run test:frontend",
    "test:frontend": "node --test tests/test_frontend.mjs tests/test_frontend_dom.mjs",
    "coverage:frontend": "c8 --all --include=static/app.js --check-coverage --lines=95 --branches=95 --functions=95 --statements=95 npm run test:frontend",
    "vendor:sync": "node scripts/sync-vendor.mjs",
    "vendor:check": "node scripts/sync-vendor.mjs --check",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "c8": "10.1.3",
    "jsdom": "26.1.0"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "11.12.0",
    "dompurify": "3.4.13",
    "jszip": "3.10.1",
    "katex": "0.18.4",
    "marked": "18.0.9",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108"
  }
}
